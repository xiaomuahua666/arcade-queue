# 复制成 .env 并填好；.env 已在 .gitignore 里，不会被提交。
# 生成随机密钥：openssl rand -hex 24

# 监听地址。0.0.0.0 = 公网可访问控制台；127.0.0.1 = 仅本机（控制台走 SSH 转发）
HOST=0.0.0.0
PORT=8787

DB_PATH=./data/arcade-queue.db

# 控制台访问密钥。留空则管理 API 全部拒绝访问。
CONSOLE_TOKEN=

# OneBot 上报签名密钥，必须与 NapCat 里配的 Secret 完全一致。
ONEBOT_SECRET=

# 可选：配了才向 Nearcade 写上报（不配仍可读取 Nearcade 数据）
NEARCADE_TOKEN=

# 可选：和风天气 key。不配则只用 Open-Meteo（免 key，够用）
QWEATHER_KEY=
QWEATHER_HOST=devapi.qweather.com

# 可选：仅「主动推送」需要，日常被动回复用不到
ONEBOT_API_BASE=
ONEBOT_ACCESS_TOKEN=
