# 复制成 .env 并填好；.env 已在 .gitignore 里，不会被提交。
# 生成随机密钥：openssl rand -hex 24

# 监听地址。0.0.0.0 = 公网可访问控制台；127.0.0.1 = 仅本机（控制台走 SSH 转发）
HOST=0.0.0.0
PORT=8787

# 是否信任 X-Forwarded-For 头来判定客户端 IP（用于密钥爆破限流的记账）。
#
# 保持 false，除非本服务确实跑在 nginx 之类会重写该头的反向代理之后。
# 直连公网时该头完全由客户端控制，信任它等于把限流交给攻击者：
# 每个请求换一个值就能无限次试密钥。
TRUST_PROXY=false

DB_PATH=./data/arcade-queue.db

# 日志文件。程序同时往屏幕和这个文件写，所以在 screen 里跑也能查历史。
# 留空则只输出到屏幕。
LOG_FILE=./data/arcade-queue.log
# 日志超过这个大小（MB）就轮转，旧的存成 .log.1，只保留一份，不会写满磁盘。
LOG_MAX_MB=10

# 控制台访问密钥。留空则管理 API 全部拒绝访问。
CONSOLE_TOKEN=

# OneBot 上报签名密钥，必须与 NapCat 里配的 Secret 完全一致。
ONEBOT_SECRET=

# 可选：配了才向 Nearcade 写上报（不配仍可读取 Nearcade 数据）
NEARCADE_TOKEN=

# 可选：和风天气 key。不配则只用 Open-Meteo（免 key，够用）
QWEATHER_KEY=
QWEATHER_HOST=devapi.qweather.com

# 可选：仅「主动推送」需要，日常被动回复用不到
ONEBOT_API_BASE=
ONEBOT_ACCESS_TOKEN=
